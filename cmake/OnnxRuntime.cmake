# Locate (or download) a prebuilt ONNX Runtime CPU release and expose it as onnxruntime_imported.
# Official releases: https://github.com/microsoft/onnxruntime/releases (MIT License)

if(NOT ONNXRUNTIME_ROOT)
    if(WIN32)
        set(_ort_pkg "onnxruntime-win-x64-${ONNXRUNTIME_VERSION}")
        set(_ort_ext "zip")
    elseif(APPLE)
        # 新版本官方只发布 Apple 芯片（arm64）的 macOS 包；Intel（x86_64）包最后一版是 1.23.2，
        # 给 Intel 版 OBS 构建插件时用 -DCMAKE_OSX_ARCHITECTURES=x86_64 -DONNXRUNTIME_VERSION=1.23.2
        if(CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
            set(_ort_pkg "onnxruntime-osx-x86_64-${ONNXRUNTIME_VERSION}")
        else()
            set(_ort_pkg "onnxruntime-osx-arm64-${ONNXRUNTIME_VERSION}")
        endif()
        set(_ort_ext "tgz")
    else()
        message(FATAL_ERROR "Set ONNXRUNTIME_ROOT to an extracted ONNX Runtime release")
    endif()
    set(_ort_url "https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/${_ort_pkg}.${_ort_ext}")
    set(_ort_dir "${CMAKE_BINARY_DIR}/_deps/${_ort_pkg}")
    if(NOT EXISTS "${_ort_dir}/include")
        message(STATUS "Downloading ${_ort_url}")
        file(DOWNLOAD "${_ort_url}" "${CMAKE_BINARY_DIR}/_deps/${_ort_pkg}.${_ort_ext}" STATUS _ort_status SHOW_PROGRESS)
        list(GET _ort_status 0 _ort_code)
        if(NOT _ort_code EQUAL 0)
            message(FATAL_ERROR "Failed to download ONNX Runtime: ${_ort_status}")
        endif()
        file(ARCHIVE_EXTRACT INPUT "${CMAKE_BINARY_DIR}/_deps/${_ort_pkg}.${_ort_ext}" DESTINATION "${CMAKE_BINARY_DIR}/_deps")
    endif()
    set(ONNXRUNTIME_ROOT "${_ort_dir}")
endif()

find_path(ONNXRUNTIME_INCLUDE_DIR onnxruntime_c_api.h
    PATHS "${ONNXRUNTIME_ROOT}/include" "${ONNXRUNTIME_ROOT}/include/onnxruntime" NO_DEFAULT_PATH REQUIRED)
find_library(ONNXRUNTIME_LIB onnxruntime PATHS "${ONNXRUNTIME_ROOT}/lib" NO_DEFAULT_PATH REQUIRED)
if(WIN32)
    find_file(ONNXRUNTIME_DLL onnxruntime.dll PATHS "${ONNXRUNTIME_ROOT}/lib" "${ONNXRUNTIME_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
else()
    # 只拷贝真实文件；版本号符号链接由加载器按 install name 解析
    get_filename_component(ONNXRUNTIME_DLL "${ONNXRUNTIME_LIB}" REALPATH)
    file(GLOB ONNXRUNTIME_EXTRA_LIBS "${ONNXRUNTIME_ROOT}/lib/libonnxruntime*.dylib")
    list(REMOVE_ITEM ONNXRUNTIME_EXTRA_LIBS "${ONNXRUNTIME_DLL}")
endif()

add_library(onnxruntime_imported INTERFACE)
target_include_directories(onnxruntime_imported INTERFACE "${ONNXRUNTIME_INCLUDE_DIR}")
target_link_libraries(onnxruntime_imported INTERFACE "${ONNXRUNTIME_LIB}")
